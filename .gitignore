# Dependencies
node_modules/
# package-lock.json is intentionally COMMITTED: `npm ci` requires it, and it is
# what makes dependency resolution reproducible between local, CI, and Vercel.

# Environment
# Ignore every .env variant by default. Naming individual files leaves
# variants like .env.stage or .env.vercel committable.
.env*
!.env.example

# Non-dotfile env dumps and key material. These patterns are deliberately
# broad: anything shaped like a secrets file must be uncommittable.
env.txt
ENV_EXAMPLE.txt
*env*.txt
*.key
*_PRIVATE_KEY*

# Database
*.db
*.db-shm
*.db-wal

# Build outputs
public/dist/
client/dist/
dist/
.next/
out/
artifacts/
broadcast/
cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Private keys
*.pem
private-key.pem
private-key-stage.pem

#Ignore cursor AI rules
.cursor/rules/codacy.mdc
.codacy/
