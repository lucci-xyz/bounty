# Dependencies
node_modules/
# package-lock.json is intentionally COMMITTED: `npm ci` requires it, and it is
# what makes dependency resolution reproducible between local, CI, and Vercel.

# Environment
# Ignore every .env variant by default. The previous list named only .env,
# .env.local, and .env.production, which left files like .env.stage and
# .env.vercel committable — both had in fact been committed (with empty values).
.env*
!.env.example

# Database
*.db
*.db-shm
*.db-wal

# Build outputs
public/dist/
client/dist/
dist/
.next/
out/
artifacts/
broadcast/
cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Private keys
*.pem
private-key.pem
private-key-stage.pem

#Ignore cursor AI rules
.cursor/rules/codacy.mdc
.codacy/
